# Variáveis de ambiente — PeleIA
# NUNCA comite este arquivo no Git!
# Adicione .env ao .gitignore

# ── Ambiente / cotas ──────────────────────────────────────
# closed_testing → 20 free (Play closed testing)
# production     → 1 free  (launch real)
# Também no Worker: wrangler.toml ENVIRONMENT=
PELEIA_ENV=closed_testing

# ── Gemini API ────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
# ── Backend Proxy (Produção - Não expõe chaves no client) ────
# Deixe vazio em dev local para usar o SDK direto
GEMINI_PROXY_URL=https://proxy.peleia.com/analyze

# ── RevenueCat ────────────────────────────────────────────
# Obtenha em: https://app.revenuecat.com → Project → API Keys → Google Play
REVENUECAT_ANDROID_KEY=sua_chave_revenuecat_aqui
