# PeleIA — local / CI defines. Copy to `.env` for `flutter run --dart-define-from-file=.env`
# Do NOT add `.env` to pubspec assets. Do NOT commit real keys.

# closed_testing → 20 free (Play closed testing)
# production     → 1 free  (launch)
# Also set Worker wrangler.toml ENVIRONMENT= to match.
PELEIA_ENV=closed_testing

# Client never needs GEMINI_API_KEY in release — Worker holds it.
# Debug-only direct Gemini (no proxy):
# GEMINI_API_KEY=
GEMINI_PROXY_URL=https://YOUR_WORKER.workers.dev

# RevenueCat public Android SDK key (safe in client; still prefer dart-define in CI)
REVENUECAT_ANDROID_KEY=your_revenuecat_android_sdk_key
